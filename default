server {
    listen 80;
    server_name localhost;

    access_log /var/log/nginx/access.log;
    error_log  /var/log/nginx/error.log;

    # ModSecurity enabled globally; site local toggle (optional)
    modsecurity on;
    modsecurity_rules_file /etc/nginx/modsec/main.conf;

    # Proxy all requests to Apache (XAMPP) backend on Windows
    location / {
        proxy_pass http://127.0.0.1:8081;   # <-- change port if your Apache uses a different port
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Friendly response for blocked requests (optional)
    location = /RequestDenied {
        internal;
        return 403 "Request blocked by WAF\n";
    }
}
